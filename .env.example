# Text: Google Gemini Free (multi-key rotation)
GEMINI_API_KEY=
# Optional extra keys for Nano Banana image rotation + Gemini text rotation (429 → next key)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Or comma-separated: GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-flash-lite-latest
DAILY_GEMINI_LIMIT=80

# Brand face for identity-preserving covers (default: data/brand/face.jpg)
# BRAND_FACE_IMAGE=data/brand/face.jpg
# When face.jpg exists, ALL THREE identity providers receive it:
#   1) UnoRouter (/images/edits)  2) Nano Banana (inlineData)  3) Skywork (source_images)
# xKiro is diagram-only and never receives the face.
# REQUIRE_BRAND_FACE=true
# Set false only if you accept random faces when identity providers fail:
# REQUIRE_BRAND_FACE=false

# ── Brand person description (single source of truth) ─────────────────────────
# Injected into every identity prompt. The pipeline does NOT detect faces, so this
# text + face.jpg are the only identity signals the model gets.
# IMPORTANT: update this if your real appearance changes (e.g. you grow a beard) —
# a stale description actively fights the reference photo.
# BRAND_IDENTITY_DESCRIPTION=Uzbek man in his mid-30s, completely clean-shaven, short dark textured hair with neat faded sides, dark brown eyes

# ── Face verification (does the generated cover actually contain your face?) ──
# A Gemini vision pass compares the generated cover against face.jpg. If the same
# person is not detected, the image is rejected and the pipeline cascades to the
# next identity provider instead of publishing a generic stranger.
# Runs only when REQUIRE_BRAND_FACE=true AND face.jpg exists.
FACE_VERIFY=true
# Any multimodal Gemini model works. Override if your key cannot access this one.
GEMINI_VISION_MODEL=gemini-2.5-flash
# Soft daily verification calls PER Gemini key (UTC). Separate bucket, so this
# never consumes the DAILY_GEMINI_LIMIT used for article text.
DAILY_FACEVERIFY_LIMIT=40
# Minimum confidence (0–1) required to accept an image as "the same person".
FACE_VERIFY_MIN_CONFIDENCE=0.6

# Skywork Image API — waterfall #2 after Nano Banana (multi-key rotation)
# Get keys: https://skywork.ai/?openApiKeySetting=1
SKYWORK_API_KEY=
SKYWORK_API_KEY_2=
SKYWORK_API_KEY_3=
SKYWORK_API_KEY_4=
SKYWORK_API_KEY_5=
# Or comma-separated: SKYWORK_API_KEYS=key1,key2,key3
SKYWORK_GATEWAY_URL=https://api-tools.skywork.ai/theme-gateway
# Soft cap PER KEY (UTC). Total ≈ limit × keys
DAILY_SKYWORK_LIMIT=4
SKYWORK_RESOLUTION=1K
SKYWORK_ASPECT_RATIO=1:1

IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_TEMP_HOURS=24
IMGBB_API_KEY=

# Telegram (bot token — not OAuth)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
# Optional private chat for ops alerts (default = TELEGRAM_CHANNEL)
TELEGRAM_ALERT_CHAT=
# Inbound bot: admin sends photo/video + caption → publish to all ENABLED_PLATFORMS
# TELEGRAM_BOT_INBOUND=false to disable long-poll bot
TELEGRAM_BOT_INBOUND=true
# Your Telegram user id(s), comma-separated. DM the bot /whoami to get your id.
TELEGRAM_ADMIN_IDS=
# Warn on Telegram when token has ≤ N days left (default 1)
TOKEN_ALERT_DAYS=1
TOKEN_ALERT_ENABLED=true

# ── Unified OAuth Manager (npm run auth -- <platform>) ──
# Callback server: http://localhost:3000/auth/<platform>/callback

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_USER_ID=
LINKEDIN_REFRESH_TOKEN=
# Company Page numeric id (from the admin URL: .../company/<id>/...).
# Required only when LINKEDIN_POST_AS includes organization.
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_POST_AS=person
LINKEDIN_REQUEST_ORG_SCOPE=false


# Facebook / Meta
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram Graph (often same Meta app)
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/auth/threads/callback
THREADS_TOKEN=
THREADS_USER_ID=

# X (Twitter) — OAuth 2.0 PKCE and/or OAuth 1.0a
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/auth/x/callback
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Blogger (Google OAuth) — https://console.cloud.google.com → OAuth client
# Enable: Blogger API v3. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOGGER_REDIRECT_URI=http://localhost:3000/auth/blogger/callback
BLOGGER_URL=https://istamjon.blogspot.com/
BLOGGER_ACCESS_TOKEN=
BLOGGER_REFRESH_TOKEN=
# Optional — auto-resolved from BLOGGER_URL public feed (istamjon → 6041787032258205448)
# BLOGGER_BLOG_ID=

# Database / scheduler
DB_PATH=./data/app.db
CRON_INTERVAL_MINUTES=30
DRY_RUN=false
# Try up to N articles per slot; stops after first successful publish
MAX_ARTICLES_PER_RUN=3

# Soft daily publish caps (4 posts/day policy)
DAILY_LIMIT_TELEGRAM=4
DAILY_LIMIT_LINKEDIN=4
DAILY_LIMIT_FACEBOOK=4
DAILY_LIMIT_INSTAGRAM=4
DAILY_LIMIT_X=4
DAILY_LIMIT_THREADS=4
DAILY_LIMIT_BLOGGER=4

# Image waterfall: UnoRouter (gpt-image-2:free) → Nano Banana (Gemini) → Skywork → xKiro
# UnoRouter Image API (waterfall #1):
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_IMAGE_MODEL=gpt-image-2:free
UNOROUTER_FALLBACK_MODELS=gpt-image:free,glm-image-1:free,sensenova-6.8-flash-lite:free,cogview-4-250304:free
# Extra models that accept a face reference via POST /images/edits.
# ONLY these can preserve the brand face — all others are prompt-only.
# Built-in defaults (gpt-image-2:free, gpt-image-2) are always included; add
# newly discovered edit-capable models here without touching the code:
# UNOROUTER_EDIT_MODELS=some-new-image-model:free
UNOROUTER_EDIT_MODELS=
DAILY_UNOROUTER_LIMIT=15

# Nano Banana config (waterfall #2):
NANOBANANA_IMAGE_MODEL=gemini-2.5-flash-image
DAILY_NANOBANANA_LIMIT=3
# (Soft cap PER KEY (UTC). Total ≈ limit × number of Gemini keys)

# xKiro Image API (waterfall #3 after Skywork):
XKIRO_API_KEY=
# XKIRO_API_KEY_2=
# XKIRO_API_KEY_3=
XKIRO_IMAGE_MODEL=sensenova/sensenova-u1.5-lite
XKIRO_IMAGE_SIZE=1024x1024
DAILY_XKIRO_LIMIT=10

# Schedule: random times every LOCAL day (TZ, e.g. Asia/Tashkent)
CRON_RANDOM=true
# Random slots each local day (inclusive range)
CRON_SLOTS_MIN=3
CRON_SLOTS_MAX=6
# Legacy fixed count (ignored when MIN/MAX set)
CRON_SLOTS_PER_DAY=4
CRON_WINDOW_START_HOUR=8
CRON_WINDOW_END_HOUR=21
# Min minutes between random slots (auto-shrinks if N slots cannot fit)
CRON_MIN_GAP_MINUTES=150
# Fixed times only if CRON_RANDOM=false
CRON_TIMES=09:30,19:30
# true = one run immediately on container start (catch-up still works)
CRON_RUN_ON_START=false

# Soft caps PER PLATFORM per local day — must be >= CRON_SLOTS_MAX
# (otherwise later random slots hit "Daily limit reached")
# DAILY_LIMIT_TELEGRAM=6
# DAILY_LIMIT_LINKEDIN=6
# DAILY_LIMIT_FACEBOOK=6
# DAILY_LIMIT_INSTAGRAM=6
# DAILY_LIMIT_THREADS=6

LANGSMITH_API_KEY=